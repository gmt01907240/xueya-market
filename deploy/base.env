# 容器默认运行配置（通用、安全，不含演示专用开关）
#
# 公开演示：显式设置 DEPLOY_PROFILE=public-demo（或 PUBLIC_DEMO=true），
# 入口脚本 deploy/docker-entrypoint.sh 会改用 deploy/public-demo.env。
# 正式生产：通过平台 Variables 注入生产参数，并按需接入真实支付。

# 默认按生产语义运行：不写演示数据、不允许模拟支付。
# 需要公开演示时显式设置 DEPLOY_PROFILE=public-demo，入口脚本会加载 public-demo.env。
NODE_ENV=production

# 监听所有网卡，适配容器与 PaaS 平台
HOST=0.0.0.0
DATA_DIR=./data
