# =============================================================================
# 学涯集市 · 生产环境支付配置模板
# -----------------------------------------------------------------------------
# 使用方法：
#   1. 复制为 .env.production（不要提交到版本库，权限设置为仅运行账户可读）
#   2. 按渠道签约材料填写，所有 ***_PATH 指向服务器上的绝对路径或 deploy/certs 下文件
#   3. 先执行预检：npm run payment:preflight -- --env-file=.env.production
#   4. 预检全部 PASS 后，再执行：
#        node --env-file=.env.production server/index.js
#   5. 任何一项为 FAIL 时服务会拒绝启动，禁止为了“先跑起来”绕过闸门
#
# 安全要求：
#   - 私钥、APIv3 密钥、商户密钥只能放在服务器本地或密钥管理服务，禁止入库、禁止打印
#   - 回调地址必须是已备案域名下的 HTTPS 地址，且能被公网访问
#   - 生产环境禁止设置 PAYMENT_MODE=mock
# =============================================================================

NODE_ENV=production
PORT=3300
HOST=0.0.0.0
DATA_DIR=/var/lib/xueya

# 支付总闸门：三个值必须同时满足，缺一不可
PAYMENT_MODE=live
PAYMENT_LIVE_ENABLED=true
# 按实际签约渠道启用，逗号分隔：wechat,alipay,bankcard
PAYMENT_CHANNELS=wechat,alipay,bankcard

# -----------------------------------------------------------------------------
# 微信支付 APIv3（Native 扫码）
# 商户平台：https://pay.weixin.qq.com
# -----------------------------------------------------------------------------
WECHAT_APP_ID=wx****************
WECHAT_MCH_ID=16********
# 商户 API 证书序列号（商户平台 → 账户中心 → API 安全 → 商户 API 证书）
WECHAT_MCH_SERIAL_NO=********************************
# 商户 API 私钥 apiclient_key.pem 路径
WECHAT_MCH_PRIVATE_KEY_PATH=/etc/xueya/certs/wechat/apiclient_key.pem
# 微信支付平台证书 wechatpay_*.pem 路径（用于回调验签）
WECHAT_PLATFORM_CERT_PATH=/etc/xueya/certs/wechat/wechatpay_platform.pem
# APIv3 密钥：必须正好 32 字节
WECHAT_API_V3_KEY=********************************
# 公网 HTTPS 回调，必须指向 /api/payments/callback/wechat
WECHAT_NOTIFY_URL=https://pay.example.edu.cn/api/payments/callback/wechat
# 可选：私有化/代理网关时覆盖
# WECHAT_API_BASE=https://api.mch.weixin.qq.com

# -----------------------------------------------------------------------------
# 支付宝开放平台（当面付预下单）
# 开放平台：https://open.alipay.com
# -----------------------------------------------------------------------------
ALIPAY_APP_ID=2021********
# 应用私钥（RSA2，PKCS#8 PEM）
ALIPAY_APP_PRIVATE_KEY_PATH=/etc/xueya/certs/alipay/app_private_key.pem
# 支付宝公钥（不是应用公钥），用于验签
ALIPAY_PUBLIC_KEY_PATH=/etc/xueya/certs/alipay/alipay_public_key.pem
ALIPAY_NOTIFY_URL=https://pay.example.edu.cn/api/payments/callback/alipay
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SIGN_TYPE=RSA2

# -----------------------------------------------------------------------------
# 银联全渠道（二维码主扫）
# 说明：银联存在全渠道 / 银联商务等不同产品线，字段以签约时下发的接口文档为准。
# -----------------------------------------------------------------------------
UNIONPAY_MER_ID=8****************
# 11 = SHA256 + RSA（推荐）；01 = MD5
UNIONPAY_SIGN_METHOD=11
UNIONPAY_PRIVATE_KEY_PATH=/etc/xueya/certs/unionpay/mer_private_key.pem
UNIONPAY_CERT_ID=****
UNIONPAY_PUBLIC_CERT_PATH=/etc/xueya/certs/unionpay/unionpay_public_cert.pem
# 签名方式为 01 时使用
# UNIONPAY_MD5_KEY=********************************
UNIONPAY_BACK_URL=https://pay.example.edu.cn/api/payments/callback/bankcard
# 可选：前台跳转地址
UNIONPAY_FRONT_URL=https://pay.example.edu.cn/pay/result
# UNIONPAY_API_BASE=https://gateway.95516.com/gateway/api

# -----------------------------------------------------------------------------
# 站点主体与对外联系方式（前台页脚、协议页、客服页展示）
# -----------------------------------------------------------------------------
# 客服邮箱；留空时前台展示 site.js 中的【待填写】提示，务必填写真实邮箱
SUPPORT_EMAIL=请填写真实客服邮箱（如 service@your-domain.edu.cn）

# -----------------------------------------------------------------------------
# 管理员与运行安全（非支付直连，但生产必须配置）
# -----------------------------------------------------------------------------
# 首次启动注入的管理员口令，启动后请立即在后台修改并使用 MFA
ADMIN_INITIAL_PASSWORD=请替换为至少16位的强口令
# 后台访问白名单（CIDR，逗号分隔）
ADMIN_IP_ALLOWLIST=10.0.0.0/8,192.168.0.0/16
# 管理员专属登录路径
ADMIN_LOGIN_PATH=/ops-login
