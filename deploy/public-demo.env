# 公开演示环境配置（对外可访问，保留模拟支付，不接真实资金）
#
# 启动：npm run start:public
# 该文件由 node --env-file 加载，不会覆盖平台已注入的 PORT/DATA_DIR 等变量。

NODE_ENV=staging
DEPLOY_PROFILE=public-demo
PUBLIC_DEMO=true

# 新注册用户提交实名信息后自动通过，保证注册即可体验完整买卖链路
AUTO_VERIFY=true

# 演示内容：写入演示账号与样例资料，便于新用户注册后立即下单
SEED_DEMO=true

# 支付：模拟通道，页面明确标注「演示支付 · 不产生真实扣款」
PAYMENT_MODE=mock
PAYMENT_MOCK_SECRET=xueya-public-demo-3f9c1a7b5e2d4c8f9a0b6d3e7c1f5a2b

# 功能开关：注册、上传、支付、规划、砍价、AI 客服、工单全部开启
FEATURE_REGISTRATION=on
FEATURE_UPLOAD=on
FEATURE_PAYMENTS=on
FEATURE_PLAN=on
FEATURE_BARGAIN=on
FEATURE_AI_SUPPORT=on
FEATURE_TICKETS=on

# 演示环境支付成功即结算，便于观察收益
SETTLEMENT_DELAY_HOURS=0

# 托管平台在反向代理之后，信任 X-Forwarded-For 以按真实 IP 限流
TRUST_PROXY=true

# 公网演示关闭管理后台：白名单指向 TEST-NET，任何真实来源均无法进入后台
ADMIN_IP_ALLOWLIST=192.0.2.1/32

# 监听所有网卡
HOST=0.0.0.0
DATA_DIR=./data
